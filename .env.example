# CODE DECK configuration. Copy to `.env` (repo checkout / Docker) or to
# ~/.config/code-deck/.env (installed service + menu bar app), or run
# `code-deck init`, which writes the latter for you.
#
# Every line is optional: the commented values are the defaults. Only
# CODE_DECK_* keys are read, and the real environment always wins over this
# file. Nothing secret belongs here. Claude Code's own telemetry variables go
# in ~/.claude/settings.json instead (`code-deck env print`).
#
# Generated by `code-deck env example`; edit config.ENV_SPEC, not this file.

# -- Server ------------------------------------------------------
# Address the builder/API binds to. 0.0.0.0 exposes it on your LAN.
# CODE_DECK_HOST=127.0.0.1
# Builder, API and player port.
# CODE_DECK_PORT=8765
# Address the Claude Code telemetry receiver binds to (Docker: 0.0.0.0).
# CODE_DECK_OTLP_HOST=127.0.0.1
# Telemetry receiver port. Claude Code's OTEL endpoint must match.
# CODE_DECK_OTLP_PORT=4318

# -- Rendering ---------------------------------------------------
# chromium (the React player) | pil (legacy) | none (API only).
# CODE_DECK_RENDERER=chromium
# Panel brightness 0-255 until you set it in the builder.
# CODE_DECK_BRIGHTNESS=39
# Render this URL instead of the bundled player, e.g. the Vite dev server.
# CODE_DECK_PLAYER_URL=

# -- Device ------------------------------------------------------
# Full path to libusb-1.0 if it isn't found automatically.
# CODE_DECK_LIBUSB=

# -- Paths -------------------------------------------------------
# Layout, preview frame and cache.
# CODE_DECK_HOME=~/.config/code-deck
# Log files. Default: ~/Library/Logs/code-deck on macOS, CODE_DECK_HOME/logs elsewhere.
# CODE_DECK_LOG_DIR=
# Claude Code's data folder (transcripts, settings.json).
# CODE_DECK_CLAUDE_DIR=~/.claude
# Codex's data folder (sessions, app-server).
# CODE_DECK_CODEX_DIR=~/.codex
# Codex app-server binary for live quota. Default: CODE_DECK_CODEX_DIR/plugins/.plugin-appserver/codex.
# CODE_DECK_CODEX_APPSERVER=

# -- Menu bar app ------------------------------------------------
# Where the macOS menu bar app finds the server.
# CODE_DECK_URL=http://127.0.0.1:8765
